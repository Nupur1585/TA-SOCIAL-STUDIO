# Copy to .env and fill in real values. Never commit .env.

PORT=5000
NODE_ENV=development

# Local MongoDB started with `docker compose up -d mongodb` (see docker-compose.yml).
# The compose file enables auth, so credentials and authSource are required.
MONGODB_URI=mongodb://admin:password@localhost:27017/ta_social_studio?authSource=admin

# Origin of the React app (used for CORS with cookies).
FRONTEND_ORIGIN=http://localhost:5173

# Long random string, at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# Initial administrator, created by `npm run seed:admin`.
# Password must be at least 12 characters. Remove it from .env after seeding if you like.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password
