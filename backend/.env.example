# Copy to .env and fill in real values. Never commit .env.

PORT=5000
NODE_ENV=development

# MongoDB connection string (a SECRET: it contains the password). The database name is the part after the host.
#
# LOCAL development (Docker, see docker-compose.yml). The compose file enables auth, so credentials and
# authSource=admin are required. The values below are EXAMPLES: use your own user and password.
# The current local database is named tech_amdavad_social_studio; it is created on first write.
MONGODB_URI=mongodb://<user>:<password>@localhost:27017/tech_amdavad_social_studio?authSource=admin
#
# PRODUCTION (MongoDB Atlas) example. Set it in the host's secret settings, never in this file or in Git:
#   mongodb+srv://<app-user>:<password>@<cluster-host>/<production-database-name>?retryWrites=true&w=majority
# Always include the database name (otherwise MongoDB uses "test"), use a dedicated user with readWrite on that
# database only, and do not copy authSource=admin from the local string.

# Origin of the React app (used for CORS with cookies).
FRONTEND_ORIGIN=http://localhost:5173

# Long random string, at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# Initial administrator, created by `npm run seed:admin`.
# Password must be at least 12 characters. Remove it from .env after seeding if you like.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password


# Uploaded media AND generated reports are stored on local disk (not in MongoDB). Defaults to backend/uploads.
# In production, point this at a persistent volume (a container/host filesystem is usually wiped on redeploy).
# MongoDB keeps only the metadata, so restoring a database without these files leaves broken media rows.
UPLOAD_DIR=uploads

# ---------------------------------------------------------------------------
# Social account connections (names and descriptions only; put real values in .env)
# ---------------------------------------------------------------------------

# REQUIRED to connect any account. Encrypts OAuth tokens (AES-256-GCM) before they are stored.
# 32 random bytes as 64 hex characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing or changing this key makes stored tokens unreadable: accounts must be reconnected.
TOKEN_ENCRYPTION_KEY=

# Meta app (Instagram + Facebook). Create at https://developers.facebook.com/apps
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:5000/api/social/callback/meta
# META_GRAPH_VERSION=v21.0

# Google Cloud OAuth client (YouTube). Create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/social/callback/google

# LinkedIn app. Create at https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:5000/api/social/callback/linkedin

# X developer project/app (OAuth 2.0). Create at https://developer.x.com/en/portal/dashboard
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:5000/api/social/callback/x

# ---------------------------------------------------------------------------
# Publishing
# ---------------------------------------------------------------------------

# Public HTTPS address of THIS backend, reachable from the internet (a deployed domain or a tunnel such as
# ngrok / Cloudflare Tunnel). Instagram downloads media from it through short-lived signed links.
# Not needed for Facebook, YouTube, LinkedIn or X. localhost does not work for Instagram.
PUBLIC_BASE_URL=

# YouTube privacy for uploads: private (default), unlisted or public. Unverified Google projects force private.
# YOUTUBE_DEFAULT_PRIVACY=private

# LinkedIn REST API version header (YYYYMM). Change when LinkedIn retires the default.
# LINKEDIN_API_VERSION=202504

# How often the scheduler looks for due posts (seconds, minimum 10).
# SCHEDULER_INTERVAL_SECONDS=30

# ---------------------------------------------------------------------------
# AI content generation (Anthropic Claude). Create a key at https://console.anthropic.com/
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5-5
# AI_TIMEOUT_SECONDS=60
# AI_RATE_LIMIT_PER_MINUTE=10
# ANTHROPIC_BASE_URL=https://api.anthropic.com   # only for a proxy/gateway

# ---------------------------------------------------------------------------
# Production / same-origin hosting
# ---------------------------------------------------------------------------

# Set to production when deployed. Makes the session cookie Secure (HTTPS only) and enables startup checks:
# FRONTEND_ORIGIN and every configured provider's *_REDIRECT_URI must then be public https URLs.
# NODE_ENV=production

# Number of reverse proxies in front of this app (a platform load balancer is usually 1). Leave unset when
# the app is reached directly: otherwise clients could spoof their IP in the audit log and rate limiters.
# TRUST_PROXY=1

# Folder with the built React app. Defaults to ../frontend/dist next to this backend; when it exists the
# backend serves it (and index.html for page routes) from the same origin as /api.
# FRONTEND_DIST=
