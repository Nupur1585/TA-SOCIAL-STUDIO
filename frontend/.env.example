# Public values only: anything starting with VITE_ is visible to every visitor. Never put secrets here.

# Base URL of the backend API, including /api. Leave unset in development (defaults to http://localhost:5000/api).
# Production: set to the deployed API, e.g. https://api.example.com/api, or leave unset to use same-origin "/api".
# VITE_API_URL=
